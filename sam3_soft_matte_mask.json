rabbing the background."],"color":"#432","bgcolor":"#653"},{"id":202,"type":"Note","pos":[653,-1400],"size":[690,230],"flags":{},"order":5,"mode":0,"inputs":[],"outputs":[],"properties":{},"widgets_values":["C - DETECTION + EDGE SOFTENING\n\nSAM3 Detect returns a hard mask per frame; GrowMaskWithBlur turns it\ninto something compositable.\n\n  expand      dilate in pixels\n  blur_radius feather in pixels\n\n  detail branch  generous expand + blur - hides detection jitter\n  subject branch almost no expand, 1 px blur - keeps the silhouette\n\nindividual_masks = false -> one merged mask per frame.\nrefine_iterations trades speed for edge accuracy."],"color":"#432","bgcolor":"#653"},{"id":210,"type":"LazySwitchKJ","pos":[1870,-1090],"size":[365.0000061035156,100],"flags":{},"order":26,"mode":0,"inputs":[{"localized_name":"on_false","name":"on_false","type":"*","link":230},{"localized_name":"on_true","name":"on_true","type":"*","link":219},{"localized_name":"switch","name":"switch","type":"BOOLEAN","widget":{"name":"switch"},"link":null}],"outputs":[{"localized_name":"*","name":"*","type":"*","links":[231,232]}],"title":"7b. SWITCH 1 - LUMA SOFT MATTE (default: off)","properties":{"cnr_id":"comfyui-kjnodes","ver":"1.4.0","Node name for S&R":"LazySwitchKJ"},"widgets_values":[false],"color":"#232","bgcolor":"#353"},{"id":203,"type":"Note","pos":[-216.8033721255497,-127.12303809741066],"size":[520,280],"flags":{},"order":6,"mode":0,"inputs":[],"outputs":[],"properties":{},"widgets_values":["D - LUMA SOFT MATTE (optional)\n\nBuilds a soft matte straight from the source frames:\n\n  source -> R channel as mask -> back to image -> Levels -> mask\n\nThe Levels black / mid / white values decide how much of the bright\ninterior survives; this is what gives the final mask a gradient\ninstead of a hard cutout.\n\n\"Grow 1px\" is bypassed (mode 4) by default - enable it if the edge\ncomes out too thin. Bypass this whole group if you only want the\nplain SAM3 mask."],"color":"#432","bgcolor":"#653"},{"id":96,"type":"VHS_VideoCombine","pos":[3536.853641277963,-795.4834577579694],"size":[264.9250030517578,238],"flags":{},"order":30,"mode":0,"inputs":[{"localized_name":"images","name":"images","type":"IMAGE","link":220},{"localized_name":"audio","name":"audio","shape":7,"type":"AUDIO","link":null},{"localized_name":"meta_batch","name":"meta_batch","shape":7,"type":"VHS_BatchManager","link":null},{"localized_name":"vae","name":"vae","shape":7,"type":"VAE","link":null},{"localized_name":"frame_rate","name":"frame_rate","type":"FLOAT","widget":{"name":"frame_rate"},"link":null},{"localized_name":"loop_count","name":"loop_count","type":"INT","widget":{"name":"loop_count"},"link":null},{"localized_name":"filename_prefix","name":"filename_prefix","type":"STRING","widget":{"name":"filename_prefix"},"link":null},{"localized_name":"format","name":"format","type":"COMBO","widget":{"name":"format"},"link":null},{"localized_name":"pingpong","name":"pingpong","type":"BOOLEAN","widget":{"name":"pingpong"},"link":null},{"localized_name":"save_output","name":"save_output","type":"BOOLEAN","widget":{"name":"save_output"},"link":null}],"outputs":[{"localized_name":"Filenames","name":"Filenames","type":"VHS_FILENAMES","links":null}],"title":"11. Save mask sequence (PNG)","properties":{"cnr_id":"comfyui-videohelpersuite","ver":"4ee72c065db22c9d96c2427954dc69e7b908444b","Node name for S&R":"VHS_VideoCombine"},"widgets_values":{"frame_rate":24,"loop_count":0,"filename_prefix":"mask_out/mask_soft_","format":"video/8bit-png","pingpong":false,"save_output":true,"videopreview":""}},{"id":91,"type":"MaskToImage","pos":[3299.815629783997,-791.5544893018589],"size":[200,40],"flags":{},"order":29,"mode":0,"inputs":[{"localized_name":"mask","name":"mask","type":"MASK","link":233}],"outputs":[{"localized_name":"IMAGE","name":"IMAGE","type":"IMAGE","slot_index":0,"links":[220]}],"title":"10. Final mask -> image","properties":{"cnr_id":"comfy-core","ver":"0.21.1","Node name for S&R":"MaskToImage"},"widgets_values":[]},{"id":212,"type":"LazySwitchKJ","pos":[2853.659172271326,-791.5544893018589],"size":[397.6000122070312,100],"flags":{},"order":28,"mode":0,"inputs":[{"localized_name":"on_false","name":"on_false","type":"*","link":232},{"localized_name":"on_true","name":"on_true","type":"*","link":221},{"localized_name":"switch","name":"switch","type":"BOOLEAN","widget":{"name":"switch"},"link":null}],"outputs":[{"localized_name":"*","name":"*","type":"*","links":[233]}],"title":"9b. SWITCH 2 - SUBJECT / FULL SHAPE (default: off)","properties":{"cnr_id":"comfyui-kjnodes","ver":"1.4.0","Node name for S&R":"LazySwitchKJ"},"widgets_values":[false],"color":"#232","bgcolor":"#353"},{"id":137,"type":"MaskComposite","pos":[2516.035470522069,-733.6925812879487],"size":[270,126],"flags":{},"order":27,"mode":0,"inputs":[{"localized_name":"destination","name":"destination","type":"MASK","link":231},{"localized_name":"source","name":"source","type":"MASK","link":218},{"localized_name":"x","name":"x","type":"INT","widget":{"name":"x"},"link":null},{"localized_name":"y","name":"y","type":"INT","widget":{"name":"y"},"link":null},{"localized_name":"operation","name":"operation","type":"COMBO","widget":{"name":"operation"},"link":null}],"outputs":[{"localized_name":"MASK","name":"MASK","type":"MASK","links":[221]}],"title":"9a. Add subject / full shape (add)","properties":{"cnr_id":"comfy-core","ver":"0.21.1","Node name for S&R":"MaskComposite"},"widgets_values":[0,0,"add"]},{"id":211,"type":"Note","pos":[1884.075829685524,-1529.9250947865687],"size":[330,380],"flags":{},"order":8,"mode":0,"inputs":[],"outputs":[],"properties":{},"widgets_values":["MODE SWITCHES (LazySwitchKJ, KJNodes)\n\nDefault = both OFF -> pure SAM3 mask of the DETAIL prompt only.\nThat is the base mode; switch the rest on only when you need more.\n\n  7b  LUMA SOFT MATTE\n      on  -> the luma matte of group D is added in\n      for a soft, graded edge instead of a hard cutout\n\n  9b  SUBJECT / FULL SHAPE\n      on  -> the subject mask (prompt B, curve-shaped) is added in\n      you need the whole silhouette, e.g. as the second operand of a\n      mask operation (add / subtract / intersect) downstream\n\nBoth inputs are lazy: an off branch is NOT executed at all, so the\nbase mode costs one SAM3 pass and nothing else."],"color":"#432","bgcolor":"#653"},{"id":58,"type":"MaskComposite","pos":[1496.1158056541456,-1023.4539583948309],"size":[299.275,130],"flags":{},"order":25,"mode":0,"inputs":[{"localized_name":"destination","name":"destination","type":"MASK","link":206},{"localized_name":"source","name":"source","type":"MASK","link":210},{"localized_name":"x","name":"x","type":"INT","widget":{"name":"x"},"link":null},{"localized_name":"y","name":"y","type":"INT","widget":{"name":"y"},"link":null},{"localized_name":"operation","name":"operation","type":"COMBO","widget":{"name":"operation"},"link":null}],"outputs":[{"localized_name":"MASK","name":"MASK","type":"MASK","slot_index":0,"links":[219]}],"title":"7a. Detail mask + luma soft matte (add)","properties":{"cnr_id":"comfy-core","ver":"0.21.1","Node name for S&R":"MaskComposite"},"widgets_values":[0,0,"add"]},{"id":89,"type":"CheckpointLoaderSimple","pos":[-327.30313783136904,-924.32064903134],"size":[280,100],"flags":{},"order":0,"mode":0,"inputs":[{"localized_name":"ckpt_name","name":"ckpt_name","type":"COMBO","widget":{"name":"ckpt_name"},"link":null}],"outputs":[{"localized_name":"MODEL","name":"MODEL","type":"MODEL","slot_index":0,"links":[1,155]},{"localized_name":"CLIP","name":"CLIP","type":"CLIP","slot_index":1,"links":[2,156]},{"localized_name":"VAE","name":"VAE","type":"VAE","links":null}],"title":"1. SAM3 model (checkpoint loader)","properties":{"cnr_id":"comfy-core","ver":"0.21.1","Node name for S&R":"CheckpointLoaderSimple"},"widgets_values":["sam3.1_multiplex_fp16.safetensors"]},{"id":141,"type":"ImageToMask","pos":[2165.0296719650055,-709.3608087706484],"size":[270,58],"flags":{},"order":24,"mode":0,"inputs":[{"localized_name":"image","name":"image","type":"IMAGE","link":217},{"localized_name":"channel","name":"channel","type":"COMBO","widget":{"name":"channel"},"link":null}],"outputs":[{"localized_name":"MASK","name":"MASK","type":"MASK","links":[218]}],"title":"8c. Image -> mask","properties":{"cnr_id":"comfy-core","ver":"0.21.1","Node name for S&R":"ImageToMask"},"widgets_values":["red"]},{"id":140,"type":"dc06fff6-22dc-45f8-9c4f-0e3992bca2e3","pos":[1785.8132656480939,-712.9936913793026],"size":[343.2500061035156,420],"flags":{},"order":22,"mode":0,"inputs":[{"label":"image","localized_name":"images.image0","name":"images.image0","type":"IMAGE","link":215}],"outputs":[{"label":"IMAGE","localized_name":"IMAGE0","name":"IMAGE0","type":"IMAGE","links":[217]}],"title":"8b. Color Curves - shape subject matte falloff","properties":{"proxyWidgets":[["4","curve"],["5","curve"],["6","curve"],["7","curve"],["8","$$canvas-image-preview"]],"cnr_id":"comfy-core","ver":"0.21.1"},"widgets_values":[]},{"id":126,"type":"MaskToImage","pos":[1524.2853396617875,-712.3132445822519],"size":[215.82500305175782,40],"flags":{},"order":20,"mode":0,"inputs":[{"localized_name":"mask","name":"mask","type":"MASK","link":209}],"outputs":[{"localized_name":"IMAGE","name":"IMAGE","type":"IMAGE","slot_index":0,"links":[215]}],"title":"8a. Subject mask -> image","properties":{"cnr_id":"comfy-core","ver":"0.21.1","Node name for S&R":"MaskToImage"},"widgets_values":[]},{"id":204,"type":"Note","pos":[3366.343939591594,-486.2199883829999],"size":[440,300],"flags":{},"order":7,"mode":0,"inputs":[],"outputs":[],"properties":{},"widgets_values":["E - COMBINE + OUTPUT\n\nColor Curves (subgraph) reshapes the subject matte falloff before it\nis added in - flatten the RGB master curve to reduce its influence.\n\nBoth MaskComposite nodes use \"add\"; switch to \"multiply\" if you want\nthe intersection of the two masks instead of the union.\n\nSave: 8-bit PNG sequence, filename_prefix = <subfolder>/<name>_\nFiles land in ComfyUI/output/<subfolder>/ ready to be imported as an\nimage sequence in a compositor."],"color":"#432","bgcolor":"#653"},{"id":136,"type":"Note","pos":[-1683.54016469155,-231.60078126782435],"size":[560,300],"flags":{},"order":1,"mode":0,"inputs":[],"outputs":[],"properties":{},"widgets_values":["A - CHUNKED PROCESSING\n\nLong sequences are processed in fixed-size chunks so VRAM stays flat.\n\n  Chunk index  (PrimitiveInt)   0, 1, 2, ...   mode: increment\n  Chunk offset (MathExpression) index * CHUNK -> skip_first_frames\n  Load Video   frame_load_cap = CHUNK\n\nThe number in the expression (a * 48) MUST match frame_load_cap.\n\nUsage:\n  1. set the chunk index back to 0\n  2. enable Auto Queue and let it run through the sequence\n  3. when done: reset the chunk index to 0 and turn Auto Queue off\n\nEach run writes its own numbered batch of PNGs, so the chunks stay\nin order on disk."],"color":"#432","bgcolor":"#653"},{"id":57,"type":"VHS_LoadVideo","pos":[-864.9303127074451,-513.0967520601986],"size":[402.6499938964844,310],"flags":{},"order":12,"mode":0,"inputs":[{"localized_name":"meta_batch","name":"meta_batch","shape":7,"type":"VHS_BatchManager","link":null},{"localized_name":"vae","name":"vae","shape":7,"type":"VAE","link":null},{"localized_name":"video","name":"video","type":"COMBO","widget":{"name":"video"},"link":null},{"localized_name":"force_rate","name":"force_rate","type":"FLOAT","widget":{"name":"force_rate"},"link":null},{"localized_name":"custom_width","name":"custom_width","type":"INT","widget":{"name":"custom_width"},"link":null},{"localized_name":"custom_height","name":"custom_height","type":"INT","widget":{"name":"custom_height"},"link":null},{"localized_name":"frame_load_cap","name":"frame_load_cap","type":"INT","widget":{"name":"frame_load_cap"},"link":null},{"localized_name":"skip_first_frames","name":"skip_first_frames","type":"INT","widget":{"name":"skip_first_frames"},"link":212},{"localized_name":"sele