gosssss custom-scripts (MathExpression)\n\nRead the note inside each group before changing values."],"color":"#432","bgcolor":"#653"}],"links":[[1,89,0,88,0,"MODEL"],[2,89,1,90,0,"CLIP"],[3,90,0,88,2,"CONDITIONING"],[4,57,0,88,1,"IMAGE"],[5,57,0,20,0,"IMAGE"],[10,20,0,100,0,"MASK"],[13,101,0,102,0,"MASK"],[144,100,0,117,0,"IMAGE"],[145,117,0,101,0,"IMAGE"],[154,119,0,118,2,"CONDITIONING"],[155,89,0,118,0,"MODEL"],[156,89,1,119,0,"CLIP"],[161,57,0,118,1,"IMAGE"],[206,131,0,58,0,"MASK"],[207,88,0,131,0,"MASK"],[208,118,0,133,0,"MASK"],[209,133,0,126,0,"MASK"],[210,102,0,58,1,"MASK"],[211,135,0,134,0,"INT"],[212,134,0,57,7,"INT"],[215,126,0,140,0,"IMAGE"],[217,140,0,141,0,"IMAGE"],[218,141,0,137,1,"MASK"],[219,58,0,210,1,"*"],[220,91,0,96,0,"IMAGE"],[221,137,0,212,1,"*"],[230,131,0,210,0,"*"],[231,210,0,137,0,"*"],[232,210,0,212,0,"*"],[233,212,0,91,0,"*"]],"groups":[{"id":1,"title":"A - Chunked input","bounding":[-1699.7012961923951,-583.9230442695136,1314.1892690325076,1006.9056241717115],"color":"#3f789e","flags":{}},{"id":2,"title":"B - Model + prompts","bounding":[-377.5820100213178,-1079.1260137234092,980,620],"color":"#88A","flags":{}},{"id":3,"title":"C - SAM3 segmentation","bounding":[620,-1440,760,1000],"color":"#3f789e","flags":{}},{"id":4,"title":"D - Luma soft matte","bounding":[-220,-420,1601.3233879766537,245.42686652055443],"color":"#A88","flags":{}},{"id":5,"title":"E - Combine + output","bounding":[1420,-1180,2409.644777846419,1061.6398508365185],"color":"#3f789e","flags":{}}],"definitions":{"subgraphs":[{"id":"dc06fff6-22dc-45f8-9c4f-0e3992bca2e3","version":1,"state":{"lastGroupId":5,"lastNodeId":212,"lastLinkId":233,"lastRerouteId":0},"revision":0,"config":{},"name":"Color Curves","description":"Fine-tunes tone and color with per-channel curve adjustments using a real-time GPU fragment shader.","inputNode":{"id":-10,"bounding":[2660,-4500,120,60]},"outputNode":{"id":-20,"bounding":[4270,-4500,120,60]},"inputs":[{"id":"abc345b7-f55e-4f32-a11d-3aa4c2b