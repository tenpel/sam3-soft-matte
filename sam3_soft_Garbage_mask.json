inputs":[],"outputs":[],"properties":{},"widgets_values":["E - BODY MASS (\"intelligent repainting\")\n\n  E1  erode -30, blur 24   |  eat in from the edge, then soften\n  E2  erode -20, blur 30   |  again - the result peaks along the\n                              middle of the body and falls to zero\n                              before the silhouette edge\n  E3  remap to 0 .. 0.15      that peak is now a 15% brush\n\nTwo erode+blur passes approximate a distance transform: value by\ndistance from the edge. That is what gives MASS. A true medial-axis\nskeleton would give you a line drawing instead, which is not what you\nwant here - you are not after the centreline, you are after \"more\nopaque towards the middle\".\n\nTUNING\n  E3 max      0.10 - 0.25. Above ~0.3 the body goes milky and the\n              internal structures stop reading.\n  E1/E2 erode more negative = mass sits further inside, thinner fins\n  E1/E2 blur  more blur = softer falloff, less of a visible core edge\n\nSwitch F2b off to A/B it against the plain luma key."],"color":"#432","bgcolor":"#653"}],"links":[[1,135,0,134,0,"INT"],[2,134,0,57,7,"INT"],[3,89,0,88,0,"MODEL"],[4,89,0,118,0,"MODEL"],[5,89,1,90,0,"CLIP"],[6,89,1,119,0,"CLIP"],[7,90,0,88,2,"CONDITIONING"],[8,119,0,118,2,"CONDITIONING"],[9,57,0,88,1,"IMAGE"],[10,57,0,118,1,"IMAGE"],[11,57,0,20,0,"IMAGE"],[12,57,0,221,0,"IMAGE"],[13,88,0,131,0,"MASK"],[14,118,0,133,0,"MASK"],[15,118,0,230,0,"MASK"],[16,20,0,100,0,"MASK"],[17,100,0,117,0,"IMAGE"],[18,117,0,101,0,"IMAGE"],[19,101,0,58,0,"MASK"],[20,133,0,58,1,"MASK"],[21,230,0,231,0,"MASK"],[22,231,0,232,0,"MASK"],[23,58,0,137,0,"MASK"],[24,232,0,137,1,"MASK"],[25,58,0,212,0,"MASK"],[26,137,0,212,1,"MASK"],[27,212,0,242,0,"*"],[28,131,0,242,1,"MASK"],[29,242,0,91,0,"MASK"],[30,91,0,96,0,"IMAGE"],[31,242,0,220,0,"MASK"],[32,220,0,221,1,"MASK"],[33,221,0,222,0,"IMAGE"]],"groups":[{"id":1,"title":"A - Chunked input","bounding":[-1882.9273111082418,-1518.8869070678375,1070,580],"color":"#3f789e