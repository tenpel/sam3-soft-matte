SK","links":[28]},{"localized_name":"mask_inverted","name":"mask_inverted","type":"MASK","links":[]}],"title":"4c. Eye mask: grow + blur + fill_holes","properties":{"cnr_id":"comfyui-kjnodes","ver":"1.4.0","Node name for S&R":"GrowMaskWithBlur"},"widgets_values":[4,0,true,false,4,1,1,true]},{"id":230,"type":"GrowMaskWithBlur","pos":[1230.5331692165792,-1227.7629903157547],"size":[290,250],"flags":{},"order":16,"mode":0,"inputs":[{"localized_name":"mask","name":"mask","type":"MASK","link":15},{"localized_name":"expand","name":"expand","type":"INT","widget":{"name":"expand"},"link":null},{"localized_name":"incremental_expandrate","name":"incremental_expandrate","type":"FLOAT","widget":{"name":"incremental_expandrate"},"link":null},{"localized_name":"tapered_corners","name":"tapered_corners","type":"BOOLEAN","widget":{"name":"tapered_corners"},"link":null},{"localized_name":"flip_input","name":"flip_input","type":"BOOLEAN","widget":{"name":"flip_input"},"link":null},{"localized_name":"blur_radius","name":"blur_radius","type":"FLOAT","widget":{"name":"blur_radius"},"link":null},{"localized_name":"lerp_alpha","name":"lerp_alpha","type":"FLOAT","widget":{"name":"lerp_alpha"},"link":null},{"localized_name":"decay_factor","name":"decay_factor","type":"FLOAT","widget":{"name":"decay_factor"},"link":null},{"localized_name":"fill_holes","name":"fill_holes","shape":7,"type":"BOOLEAN","widget":{"name":"fill_holes"},"link":null}],"outputs":[{"localized_name":"mask","name":"mask","type":"MASK","links":[21]},{"localized_name":"mask_inverted","name":"mask_inverted","type":"MASK","links":[]}],"title":"E1. Erode + blur (core pass 1)","properties":{"cnr_id":"comfyui-kjnodes","ver":"1.4.0","Node name for S&R":"GrowMaskWithBlur"},"widgets_values":[-30,0,true,false,24,1,1,true]},{"id":231,"type":"GrowMaskWithBlur","pos":[1550.5331692165778,-1227.7629903157547],"size":[290,250],"flags":{},"order":18,"mode":0,"inputs":[{"localized_name":"mask","name":"mask","type":"MASK","link":21},{"localized_name":"expand","name":"expand","type":"INT","widget":{"name":"expand"},"link":null},{"localized_name":"incremental_expandrate","name":"incremental_expandrate","type":"FLOAT","widget":{"name":"incremental_expandrate"},"link":null},{"localized_name":"tapered_corners","name":"tapered_corners","type":"BOOLEAN","widget":{"name":"tapered_corners"},"link":null},{"localized_name":"flip_input","name":"flip_input","type":"BOOLEAN","widget":{"name":"flip_input"},"link":null},{"localized_name":"blur_radius","name":"blur_radius","type":"FLOAT","widget":{"name":"blur_radius"},"link":null},{"localized_name":"lerp_alpha","name":"lerp_alpha","type":"FLOAT","widget":{"name":"lerp_alpha"},"link":null},{"localized_name":"decay_factor","name":"decay_factor","type":"FLOAT","widget":{"name":"decay_factor"},"link":null},{"localized_name":"fill_holes","name":"fill_holes","shape":7,"type":"BOOLEAN","widget":{"name":"fill_holes"},"link":null}],"outputs":[{"localized_name":"mask","name":"mask","type":"MASK","links":[22]},{"localized_name":"mask_inverted","name":"mask_inverted","type":"MASK","links":[]}],"title":"E2. Erode + blur (core pass 2)","properties":{"cnr_id":"comfyui-kjnodes","ver":"1.4.0","Node name for S&R":"GrowMaskWithBlur"},"widgets_values":[-20,0,true,false,30,1,1,false]},{"id":300,"type":"Note","pos":[-1480,-2280],"size":[700,760],"flags":{},"order":1,"mode":0,"inputs":[],"outputs":[],"properties":{},"widgets_values":["LUMA-PRIMARY MATTE - for a translucent subject on a black plate\n\nThis is the inverse of the usual segmentation workflow. The mask is\nnot the answer here; the luminance is.\n\nWHY. An element shot or rendered against pure black is ALREADY\npremultiplied: RGB = alpha x colour. For a translucent, bright\nsubject on black the luminance therefore IS the alpha, to a good\napproximation. That is not a trick - it is how smoke, sparks, glass\nand fire have always been keyed. A segmentation model cannot beat it,\nbecause it is guessing at something the plate states directly.\n\nWHAT SAM3 IS FOR HERE. Not the alpha. Two narrow jobs:\n\n  garbage matte (3b)  where is there any subject at all - multiplied\n                      in, to kill reflections and sensor noise.\n                      Dilated hard on purpose: a garbage matte that\n                      clips the fins is worse than none.\n  hold-out (3a)       what must stay opaque even though it is DARK.\n                      The pupil is black, but it is part of the fish.\n                      Luminance cannot know that. A prompt can.\n\n  body mass (E)       the eroded, blurred core of the body, added\n                      back at ~15%. Without it a fully translucent\n                      body keys down to its own skeleton and organs\n                      and stops reading as a body.\n\nORDER MATTERS - see the note by the combine chain."],"color":"#432","bgcolor":"#653"},{"id":301,"type":"Note","pos":[-720,-700],"size":[430,300],"flags":{},"order":2,"mode":0,"inputs":[],"outputs":[],"properties":{},"widgets_values":["D - THE TRANSPARENCY CURVE\n\n  source -> R channel as mask -> image -> Levels -> mask\n\nThis is the primary matte, not an extra. The Levels node is where you\ndecide how the footage's brightness maps to opacity:\n\n  black_level  where transparency starts. Raise it to crush faint\n               haze and noise to zero; too high and the fin tips go.\n  mid_level    the gamma of the transparency. BELOW 128 lifts the\n               mid-tones, i.e. makes the body more solid.\n  white_level  what counts as fully opaque.\n\nGrayscale footage: the R channel is the luminance. For colour\nfootage, convert to luminance first rather than taking one channel,\notherwise a coloured subject keys unevenly."],"color":"#432","bgcolor":"#653"},{"id":57,"type":"VHS_LoadVideo","pos":[-1102.9273111082416,-1448.8869070678375],"size":[280,470],"flags":{},"order":10,"mode":0,"inputs":[{"localized_name":"meta_batch","name":"meta_batch","shape":7,"type":"VHS_BatchManager","link":null},{"localized_name":"vae","name":"vae","shape":7,"type":"VAE","link":null},{"localized_name":"video","name":"video","type":"COMBO","widget":{"name":"video"},"link":null},{"localized_name":"force_rate","name":"force_rate","type":"FLOAT","widget":{"name":"force_rate"},"link":null},{"localized_name":"custom_width","name":"custom_width","type":"INT","widget":{"name":"custom_width"},"link":null},{"localized_name":"custom_height","name":"custom_height","type":"INT","widget":{"name":"custom_height"},"link":null},{"localized_name":"frame_load_cap","name":"frame_load_cap","type":"INT","widget":{"name":"frame_load_cap"},"link":null},{"localized_name":"skip_first_frames","name":"skip_first_frames","type":"INT","widget":{"name":"skip_first_frames"},"link":2},{"localized_name":"select_every_nth","name":"select_every_nth","type":"INT","widget":{"name":"select_every_nth"},"link":null},{"localized_name":"format","name":"format","shape":7,"type":"COMBO","widget":{"name":"format"},"link":null}],"outputs":[{"localized_name":"IMAGE","name":"IMAGE","type":"IMAGE","slot_index":0,"links":[9,10,11,12]},{"localized_name":"frame_count","name":"frame_count","type":"INT","links":[]},{"localized_name":"audio","name":"audio","type":"AUDIO","links":[]},{"localized_name":"video_info","name":"video_info","type":"VHS_VIDEOINFO","links":[]}],"title":"1. Load video chunk","properties":{"cnr_id":"comfyui-videohelpersuite","ver":"4ee72c065db22c9d96c2427954dc69e7b908444b","Node name for S&R":"VHS_LoadVideo"},"widgets_values":{"video":"Translucent_fish_hovers_in_HD.mp4","force_rate":0,"custom_width":0,"custom_height":0,"frame_load_cap":48,"skip_first_frames":0,"select_every_nth":1,"format":"AnimateDiff","videopreview":{"hidden":false,"paused":false,"params":{"filename":"Translucent_fish_hovers_in_HD.mp4","type":"input","format":"video/mp4","force_rate":0,"frame_load_cap":48,"skip_first_frames":0,"select_every_nth":1}}}},{"id":232,"type":"RemapMaskRange","pos":[1870.5331692165796,-1227.7629903157547],"size":[360.3249877929687,82],"flags":{},"order":20,"mode":0,"inputs":[{"localized_name":"mask","name":"mask","type":"MASK","link":22},{"localized_name":"min","name":"min","type":"FLOAT","widget":{"name":"min"},"link":null},{"localized_name":"max","name":"max","type":"FLOAT","widget":{"name":"max"},"link":null}],"outputs":[{"localized_name":"mask","name":"mask","type":"MASK","links":[24]}],"title":"E3. Brush strength (0 -> 0.15 = a 15% soft brush)","properties":{"cnr_id":"comfyui-kjnodes","ver":"1.4.0","Node name for S&R":"RemapMaskRange"},"widgets_values":[0,0.15]},{"id":303,"type":"Note","pos":[1521.584687550327,-1885.895725983908],"size":[430,560],"flags":{},"order":3,"mode":0,"inputs":[],"outputs":[],"properties":{},"widgets_values":["F - THE COMBINE ORDER\n\n  F1  alpha = luma x garbage        MULTIPLY first, on the raw luma.\n                                    Anything outside the body dies\n                                    here and cannot come back.\n  F2  alpha = alpha + body mass     the ~15% core, so the body has\n                                    presence instead of being a\n                                    transparent x-ray.\n  F3  alpha = alpha + eye           the semantic exception, last, so\n                                    nothing can punch a hole in it.\n\nMaskComposite clamps to 0..1 after every step, so \"add\" behaves like\na soft union. Only multiply / add / subtract may be used on a soft\nmatte - and / or / xor BINARISE their inputs and will destroy it.\n\nReading it as a Photoshop recipe: luma-key the layer, mask off the\njunk, then paint mass back in with a 15% soft brush, and finally\npaint the pupil back to 100%. F2 and F3 are that brush - the\ndifference is that they follow the subject on every frame."],"color":"#432","bgcolor":"#653"},{"id":304,"type":"Note","pos":[3309.317761839327,-1239.6795593252384],"size":[480,560],"flags":{},"order":4,"mode":0,"inputs":[],"outputs":[],"properties":{},"widgets_values":["G - OUTPUT\n\nG2  the matte on its own, 8-bit PNG sequence.\nG5  the RGBA layer: source frames + this alpha, 16-BIT PNG.\n\n16 bit is deliberate. A matte this soft banded in 8 bit, especially\nafter the Levels curve and the mass add.\n\nINTERPRET IT AS PREMULTIPLIED (BLACK) in After Effects.\nThe plate is black, so the RGB is already multiplied by its own\nalpha. Importing it as straight/unmatted darkens every semi-\ntransparent pixel a second time - the classic dark-fringe look, and\non a subject that is transparent all over it is not a fringe, it is\nthe whole fish.\n\nThe mass added in group E raises alpha above the luminance, so under\npremultiplied interpretation the body lifts slightly. That is the\nintended effect, not an error.\n\nG3 InvertMask is REQUIRED: JoinImageWithAlpha does alpha = 1.0 - mask\ninternally, because a ComfyUI MASK marks a region and is not an alpha\nchannel."],"color":"#432","bgcolor":"#653"},{"id":222,"type":"VHS_VideoCombine","pos":[4017.5899933856317,-346.57466932956845],"size":[280,238],"flags":{},"order":30,"mode":4,"inputs":[{"localized_name":"images","name":"images","type":"IMAGE","link":33},{"localized_name":"audio","name":"audio","shape":7,"type":"AUDIO","link":null},{"localized_name":"meta_batch","name":"meta_batch","shape":7,"type":"VHS_BatchManager","link":null},{"localized_name":"vae","name":"vae","shape":7,"type":"VAE","link":null},{"localized_name":"frame_rate","name":"frame_rate","type":"FLOAT","widget":{"name":"frame_rate"},"link":null},{"localized_name":"loop_count","name":"loop_count","type":"INT","widget":{"name":"loop_count"},"link":null},{"localized_name":"filename_prefix","name":"filename_prefix","type":"STRING","widget":{"name":"filename_prefix"},"link":null},{"localized_name":"format","name":"format","type":"COMBO","widget":{"name":"format"},"link":null},{"localized_name":"pingpong","name":"pingpong","type":"BOOLEAN","widget":{"name":"pingpong"},"link":null},{"localized_name":"save_output","name":"save_output","type":"BOOLEAN","w